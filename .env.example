# Copy to .env and edit.  Never commit .env — it holds secrets.

# ---- Option A: local Gemma via Ollama (free, offline, no key) ----
# Install https://ollama.com then:  ollama pull gemma3
GEMMA_PROVIDER=ollama
GEMMA_MODEL=gemma3
# OLLAMA_URL=http://localhost:11434

# ---- Option B: Gemma via Google AI Studio (needs a key) ----
# Get a key at https://aistudio.google.com/apikey
# GEMMA_PROVIDER=google
# GEMMA_MODEL=gemma-3-27b-it
# GOOGLE_API_KEY=your_key_here
